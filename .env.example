PROCESSING_DELAY_SECONDS=30
LEASE_SECONDS=120
MAX_ATTEMPTS=5
RETRY_BACKOFF_SECONDS=5
WORKER_CONCURRENCY=200
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_ENABLED=true
LOG_LEVEL=INFO
# Leave empty for local SQLite, or set a Postgres URI (Supabase/Neon/etc.)
